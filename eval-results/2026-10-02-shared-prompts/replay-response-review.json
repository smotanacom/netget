  "review_scope": "All 36 raw API responses reviewed; 14 unique response texts. Counter results are appearances in the first answer-shaped JSON value, not native validation or wire scores.",
  "baseline_tools_counted": 10,
  "patched_tools_counted": 0,
  "findings": [
    {
      "event": "imap_command",
      "finding": "All three baseline LIST replies add generate_random(uuid), although the fixed mailbox names need no random value. All three patched replies send the same mailbox list without a tool."
    },
    {
      "event": "http_request",
      "finding": "The first baseline reply adds generate_random(uuid); subsequent baseline replies omit it. Both variants omit the requested quotes and final period in the action body."
    },
    {
      "event": "telnet_connection_opened",
      "finding": "Every baseline reply adds generate_random(uuid) for claimed tracking; patched replies omit it. Both variants omit the final period requested in the greeting."
    },
    {
      "event": "telnet_message_received",
      "finding": "All three baseline answers have an invalid JSON string-concatenation expression in actions. The counter finds a nested generate_random tool object and no action, so its tool count is not evidence of a valid full envelope. Patched replies use a valid action-shaped object but omit requested quotes and final period."
    },
    {
      "event": "imap_auth",
      "finding": "Baseline replies contain separate conditional OK/NO JSON objects and later append_memory prose; the counter counts the first OK object only. Patched replies include an OK completion, set_memory and an additional preformatted untagged response. NetGet explicitly supports the response-only IMAP action format; this replay did not validate a wire session."
    },
    {
      "event": "imap_connection",
      "finding": "Patched replies include a greeting plus an additional untagged CAPABILITY response; baseline replies include one greeting. Extra actions count as actions in the table, without claiming that fewer actions are always better."
    },
    {
      "event": "repeated_fixed_requests",
      "finding": "Baseline IMAP connection and HTTP response texts differ between the first and later repetitions despite identical request payloads and seed. No cause is inferred; all texts, timing and API metadata are retained."
    }
  ],
